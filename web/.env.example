# Mapbox GL — optional; uses OpenFreeMap tiles when not set.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# Example: https://suburbsense.example
# NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Omit to disable GA.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Addressfinder — optional but recommended for NZ postal-grade autocomplete and meshblock lookup.
# Without this, address search falls back to OpenStreetMap (suburb match only, no meshblock).
# ADDRESSFINDER_KEY=

# Stats NZ Datafinder — enables official suburb and meshblock boundaries on the map,
# and meshblock lookup from address coordinates (without Addressfinder).
# Optional at runtime if boundaries were exported during pipeline (public/data/boundaries/).
# DATAFINDER_API_KEY=
